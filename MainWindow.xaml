<Window x:Class="BOOTWR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BOOTWR"
        xmlns:vm="clr-namespace:BOOTWR.ViewModels"
        xmlns:services="clr-namespace:BOOTWR.Services"
        mc:Ignorable="d"
        Title="CAN刷写上位机" Height="850" Width="1340"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 通用表单行样式：标签 + 控件 -->
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="FormLabelLeft" TargetType="Label" BasedOn="{StaticResource FormLabel}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <!-- 表单行：标签+控件 -->
        <Style x:Key="FormRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 工具栏 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6"
                            Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                        <TextBlock Text="CAN" Foreground="White" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CAN 刷写上位机" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Bootloader 工具" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中部：操作按钮（带分组） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 连接组 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Button Style="{StaticResource ToolbarButton}"
                                Content="连接" Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding !IsConnected &amp;&amp; !IsFlashing}"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Content="断开" Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding IsConnected &amp;&amp; !IsFlashing}"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="6,0"/>

                    <!-- 刷写组 -->
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <Button Style="{StaticResource ToolbarButton}"
                                Content="选择文件" Command="{Binding SelectFlashFileCommand}"
                                IsEnabled="{Binding !IsFlashing}"/>
                        <Button Style="{StaticResource SuccessButton}"
                                Content="开始刷写" Command="{Binding StartFlashingCommand}"
                                IsEnabled="{Binding IsConnected &amp;&amp; !IsFlashing &amp;&amp; FlashFilePath.Length > 0}"/>
                        <Button Style="{StaticResource DangerButton}"
                                Content="停止刷写" Command="{Binding StopFlashingCommand}"
                                IsEnabled="{Binding IsFlashing}"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="6,0"/>

                    <!-- 清理组 -->
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <Button Style="{StaticResource ToolbarButton}"
                                Content="清空日志" Command="{Binding ClearLogsCommand}"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Content="清空报文" Command="{Binding ClearMessagesCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：状态徽章 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusBadgeBorder}" Margin="4,0"
                            Background="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center"/>
                            <TextBlock Margin="6,0,0,0" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="{Binding IsConnected, Converter={StaticResource BooleanToTextConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorder}" Margin="4,0"
                            Background="{Binding IsFlashing, Converter={StaticResource FlashingColorConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center"/>
                            <TextBlock Margin="6,0,0,0" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="{Binding IsFlashing, Converter={local:BooleanToTextConverter TrueText='刷写中', FalseText='空闲'}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体内容 ==================== -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============== 左侧：CAN 配置 ============== -->
            <GroupBox Grid.Column="0" Header="CAN 配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 硬件配置 -->
                        <TextBlock Text="硬件参数" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="设备类型" Style="{StaticResource FormLabelLeft}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceTypes}"
                                              SelectedItem="{Binding SelectedDeviceType}"
                                              DisplayMemberPath="Name" Margin="0"/>
                                </Grid>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="设备索引" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBox Grid.Column="1" Text="{Binding DeviceIndex}" Margin="0"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="通道索引" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ChannelIndex}" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 通信参数 -->
                        <TextBlock Text="通信参数" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="波特率" Style="{StaticResource FormLabelLeft}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BaudRates}"
                                              SelectedItem="{Binding SelectedBaudRate}"
                                              DisplayMemberPath="Name" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 设备模式 -->
                        <TextBlock Text="设备模式" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="模式选择" Style="{StaticResource FormLabelLeft}"/>
                                    <ComboBox Grid.Column="1" Margin="0">
                                        <ComboBoxItem Content="BMU" IsSelected="{Binding SelectedDeviceMode, Converter={local:EnumEqualsConverter}, ConverterParameter={x:Static vm:MainWindowViewModel+DeviceMode.BMU}}"/>
                                        <ComboBoxItem Content="BCMS" IsSelected="{Binding SelectedDeviceMode, Converter={local:EnumEqualsConverter}, ConverterParameter={x:Static vm:MainWindowViewModel+DeviceMode.BCMS}}"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- UDS 地址 -->
                        <TextBlock Text="UDS 地址" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="物理地址" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBox Grid.Column="1" Text="{Binding UdsPhysicalAddress}" Margin="0"
                                             ToolTip="UDS物理地址（十六进制，如7E0）"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="响应地址" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBox Grid.Column="1" Text="{Binding UdsResponseAddress}" Margin="0"
                                             ToolTip="UDS响应地址（十六进制，如7E8）"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 刷写文件 -->
                        <TextBlock Text="刷写文件" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="路径" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FlashFilePath}"
                                             IsReadOnly="True" Margin="0" ToolTip="{Binding FlashFilePath}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="文件大小" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}"
                                               Text="{Binding FlashFileSize, StringFormat={}{0} 字节}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 会话管理 -->
                        <TextBlock Text="会话管理" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Content="打开会话" Command="{Binding OpenCalibrationSessionCommand}"
                                            IsEnabled="{Binding IsConnected &amp;&amp; !IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                            Margin="0,0,6,0" Height="30"/>
                                    <Button Content="关闭会话" Command="{Binding CloseCalibrationSessionCommand}"
                                            IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                            Height="30"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="会话状态" Style="{StaticResource FormLabelLeft}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" VerticalAlignment="Center"
                                               Text="{Binding IsCalibrationSessionOpen, Converter={local:BooleanToTextConverter TrueText='会话已打开', FalseText='会话已关闭'}}"
                                               Foreground="{Binding IsCalibrationSessionOpen, Converter={local:BooleanToColorConverter TrueColor='Green', FalseColor='Gray'}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 设备状态 -->
                        <TextBlock Text="设备状态" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="状态" Style="{StaticResource FormLabelLeft}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"
                                           Text="{Binding DeviceState}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="最后错误" Style="{StaticResource FormLabelLeft}" Margin="0,4,8,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Margin="0,4,0,0"
                                           Text="{Binding DeviceLastError}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="已写字节" Style="{StaticResource FormLabelLeft}" Margin="0,4,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Margin="0,4,0,0"
                                           Text="{Binding DeviceWrittenBytes}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="下一 count" Style="{StaticResource FormLabelLeft}" Margin="0,4,8,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Margin="0,4,0,0"
                                           Text="{Binding DeviceNextCount}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"/>

            <!-- ============== 右侧：日志 + Tab ============== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="420" MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- 操作日志 -->
                <GroupBox Grid.Row="0" Header="操作日志">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="4"
                                Padding="10,6" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="日志级别:" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="#FFDBEAFE" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="INFO" Foreground="{StaticResource LogInfoBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#FFFEF3C7" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="WARN" Foreground="{StaticResource LogWarningBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#FFFECACA" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="ERROR" Foreground="{StaticResource LogErrorBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#FFDCFCE7" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="DEBUG" Foreground="{StaticResource LogDebugBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      local:AutoScrollBehavior.AutoScroll="True">
                            <ItemsControl ItemsSource="{Binding LogMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,4">
                                            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5">
                                                <Run Text="[" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                                     Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <Run Text="] " Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <Run Text="[" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <Run Text="{Binding LevelText, Mode=OneWay}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                                <Run Text="] " Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <Run Text="{Binding Message, Mode=OneWay}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ShowsPreview="False"/>

                <!-- Tab 区 -->
                <TabControl Grid.Row="2">
                    <!-- CAN 报文 Tab -->
                    <TabItem Header="CAN 报文">
                        <DataGrid ItemsSource="{Binding CanMessages}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimestampText}" Width="140"/>
                                <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="70">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground"
                                                    Value="{Binding Direction, Converter={StaticResource DirectionToColorConverter}}"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="100"/>
                                <DataGridTextColumn Header="长度" Binding="{Binding DataLength}" Width="60"/>
                                <DataGridTextColumn Header="数据" Binding="{Binding DataHex}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- 读写操作 Tab -->
                    <TabItem Header="读写操作">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左列 -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <!-- 设备地址 -->
                                    <GroupBox Header="设备地址操作">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldCaption}" Margin="0,0,0,8">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}">
                                                        <Binding Path="SelectedDeviceMode">
                                                            <Binding.Converter>
                                                                <local:DeviceModeToAddressRangeConverter />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Grid Style="{StaticResource FormRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="地址输入" Style="{StaticResource FormLabelLeft}"/>
                                                <TextBox Grid.Column="1" Text="{Binding DeviceAddressInput}" Margin="0,0,6,0"
                                                         ToolTip="{Binding SelectedDeviceMode, Converter={local:DeviceModeToAddressRangeConverter}}"/>
                                                <Button Grid.Column="2" Content="写入地址" Command="{Binding WriteDeviceAddressCommand}"
                                                        IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; DeviceAddressInput.Length > 0 &amp;&amp; !IsBusy}"
                                                        Margin="0"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="读取结果" Style="{StaticResource FormLabelLeft}"/>
                                                <TextBox Grid.Column="1" Text="{Binding DeviceAddressReadResult}" Margin="0,0,6,0"
                                                         IsReadOnly="True"/>
                                                <Button Grid.Column="2" Content="读取地址" Command="{Binding ReadDeviceAddressCommand}"
                                                        IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                        Margin="0"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- SN 操作 -->
                                    <GroupBox Header="SN 操作">
                                        <StackPanel>
                                            <TextBlock Text="SN 最大长度 31 个字符" Style="{StaticResource FieldCaption}" Margin="0,0,0,8"/>
                                            <Grid Style="{StaticResource FormRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="SN 输入" Style="{StaticResource FormLabelLeft}"/>
                                                <TextBox Grid.Column="1" Text="{Binding SnInput}" Margin="0,0,6,0"
                                                         ToolTip="最多31个字符"/>
                                                <Button Grid.Column="2" Content="写入 SN" Command="{Binding WriteSnCommand}"
                                                        IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; SnInput.Length > 0 &amp;&amp; !IsBusy}"
                                                        Margin="0"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="读取结果" Style="{StaticResource FormLabelLeft}"/>
                                                <TextBox Grid.Column="1" Text="{Binding SnReadResult}" Margin="0,0,6,0"
                                                         IsReadOnly="True"/>
                                                <Button Grid.Column="2" Content="读取 SN" Command="{Binding ReadSnCommand}"
                                                        IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                        Margin="0"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>

                                <!-- 右列 -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <!-- 保存 -->
                                    <GroupBox Header="持久化操作">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldCaption}" Margin="0,0,0,12"
                                                       TextWrapping="Wrap">
                                                <Run Text="将 RAM 中的修改保存到 Flash"/>
                                            </TextBlock>
                                            <Button Style="{StaticResource WarningButton}"
                                                    Content="保存到 Flash" Command="{Binding SaveSnCommand}"
                                                    IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                    Height="40" FontSize="13"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 注意事项 -->
                                    <GroupBox Header="操作须知">
                                        <StackPanel>
                                            <TextBlock Text="【设备地址】" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="1. 取值："/>
                                                <Run Text="{Binding SelectedDeviceMode, Converter={local:DeviceModeToAddressRangeConverter}}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <LineBreak/>
                                                <Run Text="2. 写入后必须点击“保存到 Flash”，否则掉电丢失"/><LineBreak/>
                                                <Run Text="3. 地址为 0 时不发送周期 CAN 数据"/>
                                            </TextBlock>
                                            <TextBlock Text="【SN】" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="4. 写入 SN 后仅保存在 RAM 中"/><LineBreak/>
                                                <Run Text="5. 需打开会话并执行“保存到 Flash”才能持久化"/><LineBreak/>
                                                <Run Text="6. SN 最大长度为 31 个字符"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 热电偶标定 Tab -->
                    <TabItem Header="热电偶标定">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 会话管理 -->
                                <GroupBox Header="会话管理">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button Content="保存到 Flash" Command="{Binding SaveCalibrationCommand}"
                                                    IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                    Margin="0,0,6,0" Height="32" Background="{StaticResource WarningBrush}"
                                                    Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="14,0"/>
                                            <Button Content="恢复默认值" Command="{Binding RestoreDefaultsCommand}"
                                                    IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                    Height="32"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding IsCalibrationSessionOpen, Converter={local:BooleanToTextConverter TrueText='会话已打开', FalseText='会话已关闭'}}"
                                                   Foreground="{Binding IsCalibrationSessionOpen, Converter={local:BooleanToColorConverter TrueColor='Green', FalseColor='Gray'}}"/>
                                    </Grid>
                                </GroupBox>

                                <!-- 标定参数表 -->
                                <GroupBox Header="热电偶标定参数表">
                                    <ItemsControl ItemsSource="{Binding AfeCalibrationList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                                    <Expander Header="{Binding AfeLabel}" IsExpanded="{Binding AfeIndex, Converter={local:IndexToBoolConverter}, Mode=OneWay}" Style="{StaticResource PlusMinusExpander}">
                                                        <StackPanel>
                                                            <!-- 表头 -->
                                                            <Grid Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="68"/>
                                                                    <ColumnDefinition Width="68"/>
                                                                    <ColumnDefinition Width="68"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="通道" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="k 值" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="b 值" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="x [V]" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="y [V]" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="5" Text="读取" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="6" Text="写入" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                                <TextBlock Grid.Column="7" Text="采样" Style="{StaticResource ValueText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding TcList}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="50"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="68"/>
                                                                                <ColumnDefinition Width="68"/>
                                                                                <ColumnDefinition Width="68"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Label Grid.Column="0" Content="{Binding TcLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"/>
                                                                            <TextBox Grid.Column="1" Text="{Binding K, UpdateSourceTrigger=LostFocus}" Margin="3,0" Height="28"/>
                                                                            <TextBox Grid.Column="2" Text="{Binding B, UpdateSourceTrigger=LostFocus}" Margin="3,0" Height="28"/>
                                                                            <TextBox Grid.Column="3" Text="{Binding SampleX}" Margin="3,0" Height="28" IsReadOnly="True"
                                                                                     Background="{StaticResource CardBrush}" ToolTip="GP4 采集电压 x [V]，点击“采样”读取"/>
                                                                            <TextBox Grid.Column="4" Text="{Binding SampleY}" Margin="3,0" Height="28" IsReadOnly="True"
                                                                                     Background="{StaticResource CardBrush}" ToolTip="反解热电偶电动势 y [V]，点击“采样”读取"/>
                                                                            <Button Grid.Column="5" Content="读取" Height="28" Margin="3,0"
                                                                                    Command="{Binding DataContext.ReadSingleTcCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    IsEnabled="{Binding DataContext.IsCalibrationSessionOpen &amp;&amp; !DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                                                            <Button Grid.Column="6" Content="写入" Height="28" Margin="3,0"
                                                                                    Command="{Binding DataContext.WriteSingleTcCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    IsEnabled="{Binding DataContext.IsCalibrationSessionOpen &amp;&amp; !DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                                                            <Button Grid.Column="7" Content="采样" Height="28" Margin="3,0"
                                                                                    Command="{Binding DataContext.ReadSingleSampleCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    IsEnabled="{Binding DataContext.IsCalibrationSessionOpen &amp;&amp; !DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                    ToolTip="读取该 TC 的采集电压 x 与反解电压 y"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- Vref -->
                                                            <Grid Margin="0,8,0,0" Background="{StaticResource CardBrush}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Label Grid.Column="0" Content="Vref" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" FontWeight="SemiBold"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Vref, UpdateSourceTrigger=LostFocus}" Margin="3,4" Height="28"/>
                                                                <Button Grid.Column="2" Content="读取" Height="28" Margin="3,4"
                                                                        Command="{Binding DataContext.ReadSingleVrefCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.IsCalibrationSessionOpen &amp;&amp; !DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                                                <Button Grid.Column="3" Content="写入" Height="28" Margin="3,4"
                                                                        Command="{Binding DataContext.WriteSingleVrefCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.IsCalibrationSessionOpen &amp;&amp; !DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <!-- 批量操作 -->
                                <GroupBox Header="批量操作">
                                    <StackPanel>
                                        <TextBlock Text="一键读取：从设备读取所有标定参数；一键标定：将所有参数写入设备并保存到 Flash。"
                                                   FontSize="12" Margin="0,0,0,10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Content="一键读取" Command="{Binding ReadAllCalibrationCommand}"
                                                    IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                    Margin="0,0,8,0" Height="38" MinWidth="140" FontSize="13"/>
                                            <Button Style="{StaticResource SuccessButton}"
                                                    Content="一键标定" Command="{Binding OneClickCalibrationCommand}"
                                                    IsEnabled="{Binding IsCalibrationSessionOpen &amp;&amp; !IsBusy}"
                                                    Height="38" MinWidth="140" FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- K,B 计算 Tab -->
                    <TabItem Header="K,B 计算">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 配置与操作 -->
                                <GroupBox Header="配置">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Label Content="采样点数：" Style="{StaticResource FormLabelLeft}"/>
                                            <ComboBox ItemsSource="{Binding KbPointCountOptions}"
                                                      SelectedItem="{Binding SelectedKbPointCount}"
                                                      MinWidth="80" Height="30"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Content="计算" Command="{Binding CalculateKbCommand}"
                                                    Margin="0,0,8,0" Height="32" MinWidth="80"/>
                                            <Button Content="清空" Command="{Binding ClearKbCommand}"
                                                    Height="32" MinWidth="80"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Text="{Binding KbResultMessage}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                </GroupBox>

                                <!-- 输入表 -->
                                <GroupBox Header="输入数据 (x, y)">
                                    <StackPanel>
                                        <!-- 表头 -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource ValueText}"
                                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                       TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="x 值" Style="{StaticResource ValueText}"
                                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                       TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="y 值" Style="{StaticResource ValueText}"
                                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                       TextAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding KbInputList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Grid.Column="0" Content="{Binding IndexLabel}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Padding="0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0" Height="28"
                                                                 ToolTip="x 值，例如 GP4 采集电压 [V]"/>
                                                        <TextBox Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0" Height="28"
                                                                 ToolTip="y 值，例如反解热电偶电动势 [V]"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>

                                <!-- 结果 -->
                                <GroupBox Header="计算结果">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Style="{StaticResource FormRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="K (斜率 a)" Style="{StaticResource FormLabelLeft}"/>
                                            <TextBox Grid.Column="1" Text="{Binding KbResultK, Mode=OneWay}"
                                                     IsReadOnly="True" Margin="0,0,6,0"
                                                     FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold"/>
                                            <Label Grid.Column="3" Content="B (截距 b)" Style="{StaticResource FormLabelLeft}"/>
                                            <TextBox Grid.Column="4" Text="{Binding KbResultB, Mode=OneWay}"
                                                     IsReadOnly="True" Margin="0,0,6,0"
                                                     FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="说明：拟合方程 y = a·x + b；K = |a| × 1000 量化为 ushort（保留 3 位），"/>
                                            <Run Text="B = b × 1000 量化为 short（保留 3 位）；所有 x 相同时无法拟合直线。"/>
                                        </TextBlock>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ==================== 进度条区 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="刷写进度" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding FlashingProgress}"
                                 IsIndeterminate="{Binding IsFlashingIndeterminate}"
                                 Height="14" Minimum="0" Maximum="100"/>
                    <Border IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="Transparent" Padding="6,0">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                                   Text="{Binding FlashingProgress, StringFormat={}{0:F1}%}"/>
                    </Border>
                </Grid>

                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           Text="(0/100)"/>
            </Grid>
        </Border>

        <!-- ==================== 状态栏 ==================== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="CAN刷写上位机 v1.09" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Background="#FF334155"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="状态：" VerticalAlignment="Center" Foreground="{StaticResource StatusBarTextBrush}"/>
                    <TextBlock Text="{Binding IsConnected, Converter={local:BooleanToTextConverter TrueText='已连接', FalseText='未连接'}}"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="就绪" VerticalAlignment="Center" Foreground="{StaticResource StatusBarTextBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
