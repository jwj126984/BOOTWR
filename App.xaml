<Application x:Class="BOOTWR.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BOOTWR"
             xmlns:services="clr-namespace:BOOTWR.Services"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================ -->
            <!-- 颜色系统：现代浅色主题                        -->
            <!-- ============================================ -->
            <Color x:Key="PrimaryColor">#FF2563EB</Color>
            <Color x:Key="PrimaryHoverColor">#FF1D4ED8</Color>
            <Color x:Key="PrimaryPressedColor">#FF1E40AF</Color>

            <Color x:Key="SuccessColor">#FF16A34A</Color>
            <Color x:Key="SuccessHoverColor">#FF15803D</Color>
            <Color x:Key="SuccessPressedColor">#FF166534</Color>

            <Color x:Key="DangerColor">#FFDC2626</Color>
            <Color x:Key="DangerHoverColor">#FFB91C1C</Color>
            <Color x:Key="DangerPressedColor">#FF991B1B</Color>

            <Color x:Key="WarningColor">#FFEA580C</Color>
            <Color x:Key="WarningHoverColor">#FFC2410C</Color>
            <Color x:Key="WarningPressedColor">#FF9A3412</Color>

            <Color x:Key="InfoColor">#FF0891B2</Color>
            <Color x:Key="InfoHoverColor">#FF0E7490</Color>
            <Color x:Key="InfoPressedColor">#FF155E75</Color>

            <Color x:Key="NeutralColor">#FF475569</Color>
            <Color x:Key="NeutralHoverColor">#FF334155</Color>
            <Color x:Key="NeutralPressedColor">#FF1E293B</Color>

            <Color x:Key="BgColor">#FFF1F5F9</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="CardColor">#FFFAFBFC</Color>
            <Color x:Key="BorderColor">#FFE2E8F0</Color>
            <Color x:Key="BorderHoverColor">#FFCBD5E1</Color>
            <Color x:Key="DividerColor">#FFEEF2F6</Color>

            <Color x:Key="TextPrimaryColor">#FF0F172A</Color>
            <Color x:Key="TextSecondaryColor">#FF475569</Color>
            <Color x:Key="TextTertiaryColor">#FF94A3B8</Color>
            <Color x:Key="TextInverseColor">#FFFFFFFF</Color>

            <Color x:Key="ToolbarColor">#FFF8FAFC</Color>
            <Color x:Key="StatusBarColor">#FF1E293B</Color>
            <Color x:Key="StatusBarTextColor">#FFE2E8F0</Color>

            <Color x:Key="LogInfoColor">#FF0284C7</Color>
            <Color x:Key="LogWarningColor">#FFEA580C</Color>
            <Color x:Key="LogErrorColor">#FFDC2626</Color>
            <Color x:Key="LogDebugColor">#FF16A34A</Color>

            <Color x:Key="DirSendColor">#FF2563EB</Color>
            <Color x:Key="DirReceiveColor">#FF16A34A</Color>

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}"/>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

            <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
            <SolidColorBrush x:Key="StatusBarBrush" Color="{StaticResource StatusBarColor}"/>
            <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource StatusBarTextColor}"/>

            <SolidColorBrush x:Key="LogInfoBrush" Color="{StaticResource LogInfoColor}"/>
            <SolidColorBrush x:Key="LogWarningBrush" Color="{StaticResource LogWarningColor}"/>
            <SolidColorBrush x:Key="LogErrorBrush" Color="{StaticResource LogErrorColor}"/>
            <SolidColorBrush x:Key="LogDebugBrush" Color="{StaticResource LogDebugColor}"/>

            <SolidColorBrush x:Key="DirSendBrush" Color="{StaticResource DirSendColor}"/>
            <SolidColorBrush x:Key="DirReceiveBrush" Color="{StaticResource DirReceiveColor}"/>

            <!-- 文本悬浮背景 -->
            <SolidColorBrush x:Key="HoverBgBrush" Color="#FFF1F5F9"/>
            <SolidColorBrush x:Key="SelectedBgBrush" Color="#FFDBEAFE"/>
            <SolidColorBrush x:Key="SelectedHoverBgBrush" Color="#FFBFDBFE"/>

            <!-- ============================================ -->
            <!-- 转换器                                        -->
            <!-- ============================================ -->
            <local:BooleanToTextConverter x:Key="BooleanToTextConverter" TrueText="已连接" FalseText="未连接" />
            <local:BooleanToColorConverter x:Key="BooleanToColorConverter" TrueColor="Green" FalseColor="Red" />
            <local:BooleanToColorConverter x:Key="StatusColorConverter" TrueColor="#FF16A34A" FalseColor="#FF94A3B8" />
            <local:BooleanToColorConverter x:Key="FlashingColorConverter" TrueColor="#FFEA580C" FalseColor="#FF94A3B8" />
            <local:LogLevelToColorConverter x:Key="LogLevelToColorConverter" />
            <local:DirectionToColorConverter x:Key="DirectionToColorConverter" />
            <services:LogService x:Key="LogService" />
            <services:MessageManager x:Key="MessageManager" />

            <!-- ============================================ -->
            <!-- 全局字体                                      -->
            <!-- ============================================ -->
            <FontFamily x:Key="UIFontFamily">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style TargetType="{x:Type Label}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Padding" Value="0,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- ============================================ -->
            <!-- 卡片 / GroupBox                               -->
            <!-- ============================================ -->
            <Style x:Key="CardGroupBox" TargetType="{x:Type GroupBox}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupBox}">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Padding="10,6"
                                                CornerRadius="8,8,0,0"
                                                Background="{StaticResource CardBrush}">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              TextBlock.FontWeight="SemiBold"
                                                              TextBlock.FontSize="13"
                                                              TextBlock.Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>
                                        <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Content"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource CardGroupBox}"/>

            <!-- ============================================ -->
            <!-- 按钮                                          -->
            <!-- ============================================ -->
            <Style x:Key="BaseButton" TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="MinWidth" Value="60"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFE2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF1E40AF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SuccessButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF15803D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF166534"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFB91C1C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF991B1B"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarningButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFC2410C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF9A3412"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}"/>

            <!-- ============================================ -->
            <!-- 输入控件                                      -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource SelectedBgBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- ============================================ -->
            <!-- 状态徽章                                      -->
            <!-- ============================================ -->
            <Style x:Key="StatusBadgeBorder" TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ============================================ -->
            <!-- 工具栏                                        -->
            <!-- ============================================ -->
            <Style x:Key="AppToolBar" TargetType="{x:Type ToolBar}">
                <Setter Property="Background" Value="{StaticResource ToolbarBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="MinHeight" Value="48"/>
            </Style>

            <Style TargetType="{x:Type ToolBar}" BasedOn="{StaticResource AppToolBar}"/>
            <Style TargetType="{x:Type ToolBarTray}">
                <Setter Property="Background" Value="{StaticResource ToolbarBrush}"/>
            </Style>

            <!-- ============================================ -->
            <!-- 状态栏                                        -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type StatusBar}">
                <Setter Property="Background" Value="{StaticResource StatusBarBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource StatusBarTextBrush}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="{x:Type StatusBarItem}">
                <Setter Property="Padding" Value="8,4"/>
            </Style>

            <!-- ============================================ -->
            <!-- TabControl                                    -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="8,8,0,0">
                                        <TabPanel IsItemsHost="True" Background="Transparent" Margin="6,6,6,0"/>
                                    </Border>
                                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,8,8">
                                        <ContentPresenter ContentSource="SelectedContent" Margin="8"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TabItem}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="6,6,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================ -->
            <!-- DataGrid                                      -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="#FFF8FAFC"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="28"/>
                <Setter Property="ColumnHeaderHeight" Value="34"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SelectedBgBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBgBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ============================================ -->
            <!-- 进度条                                        -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type ProgressBar}">
                <Setter Property="Background" Value="#FFE2E8F0"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid>
                                <Border x:Name="PART_Track"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="5"/>
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================ -->
            <!-- ScrollBar                                     -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BorderHoverBrush}"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
            </Style>

            <!-- ============================================ -->
            <!-- GridSplitter                                  -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type GridSplitter}">
                <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
                <Setter Property="ShowsPreview" Value="False"/>
            </Style>

            <!-- ============================================ -->
            <!-- Expander（保留原有 +/- 切换功能）                -->
            <!-- ============================================ -->
            <Style x:Key="PlusMinusExpander" TargetType="{x:Type Expander}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Expander}">
                            <StackPanel>
                                <ToggleButton
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="6,4"
                                    IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                                                <Grid Width="18" Height="18" Background="Transparent">
                                                                    <TextBlock
                                                                        Text="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={local:BooleanToTextConverter TrueText='−', FalseText='+'}}"
                                                                        FontSize="15"
                                                                        FontWeight="Bold"
                                                                        FontFamily="Arial"
                                                                        Foreground="{StaticResource PrimaryBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ContentPresenter
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    TextBlock.FontWeight="SemiBold"
                                                                    TextBlock.FontSize="13"
                                                                    TextBlock.Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Label
                                        Content="{TemplateBinding Header}"
                                        VerticalAlignment="Center"/>
                                </ToggleButton>
                                <ContentPresenter
                                    Visibility="{TemplateBinding IsExpanded, Converter={local:BooleanToVisibilityConverter}}"
                                    Content="{TemplateBinding Content}"
                                    Margin="20,4,0,6"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
