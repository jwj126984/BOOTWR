<Window x:Class="BOOTWR.CalibrationPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动标定提示" Width="460" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Margin="16,16,16,8" Padding="16">
            <TextBlock x:Name="MessageText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" LineHeight="26"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,16">
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                    Content="已设置完成" Click="ConfirmButton_Click"
                    MinWidth="140" Height="36" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
